rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/gmail_accounts/{accountId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly([
        'email', 'label', 'status', 'color', 'lastSyncAt'
      ]);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'email', 'label', 'status', 'color', 'lastSyncAt'
      ]);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/gmail_account_tokens/{accountId} {
      allow read, write: if false;
    }

    match /users/{uid}/gmail_oauth_states/{stateId} {
      allow read, write: if false;
    }

    match /users/{uid}/notification_tokens/{tokenId} {
      allow read: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.keys().hasOnly(['token', 'userAgent', 'updatedAt']);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/notification_events/{eventId} {
      allow read, write: if false;
    }

    match /users/{uid}/{collection}/{documentId} {
      allow read, write: if isOwner(uid) && collection != 'gmail_accounts' && collection != 'gmail_account_tokens' && collection != 'gmail_oauth_states' && collection != 'notification_tokens' && collection != 'notification_events';
    }

    match /users/{uid}/{collection}/{documentId}/{nested=**} {
      allow read, write: if isOwner(uid) && collection != 'gmail_accounts' && collection != 'gmail_account_tokens' && collection != 'gmail_oauth_states' && collection != 'notification_tokens' && collection != 'notification_events';
    }
  }
}
